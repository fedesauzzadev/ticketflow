<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- F-03/NFR-6: umbral ≥70% líneas activo en cada `dotnet test` — el scope es SOLO el Core
       del servicio (Api y Shared excluidos: los .Api sin tests in-proc son deuda V1, QA F-07). -->
  <PropertyGroup>
    <CollectCoverage>true</CollectCoverage>
    <!-- Umbral activo solo con el emulador configurado (modo de verificaci�n: la cobertura
         de los Core viene de la integraci�n; sin env se omiten esos tests y el umbral no aplica). -->
    <Threshold Condition="$(AWS_EMULATOR_ACCESS_KEY_ID) != ''">70</Threshold>
    <Threshold Condition="$(AWS_EMULATOR_ACCESS_KEY_ID) == ''">0</Threshold>
    <ThresholdType>line</ThresholdType>
    <ThresholdStat>total</ThresholdStat>
    <!-- F-V1-04: el .Api propio vuelve a la cobertura del run estándar (los tests in-proc
         .Api existen desde S08) — solo queda fuera Shared.Infrastructure (deuda declarada). -->
    <Exclude>[TicketFlow.Shared.Infrastructure]*,[TicketFlow.Catalog.Core]*,[TicketFlow.Payments.Core]*,[TicketFlow.Ticketing.Core]*</Exclude>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.msbuild" Version="10.1.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" Version="11.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.23" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Services\Catalog\TicketFlow.Catalog.Core\TicketFlow.Catalog.Core.csproj" />
    <ProjectReference Include="..\..\src\Services\Orders\TicketFlow.Orders.Api\TicketFlow.Orders.Api.csproj" />
    <ProjectReference Include="..\..\src\Services\Payments\TicketFlow.Payments.Core\TicketFlow.Payments.Core.csproj" />
    <ProjectReference Include="..\..\src\Services\Ticketing\TicketFlow.Ticketing.Core\TicketFlow.Ticketing.Core.csproj" />
  </ItemGroup>

</Project>
