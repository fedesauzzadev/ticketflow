<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Umbral (F-03/NFR-6) con scope = SOLO el ensamblado Provision: los 4 Core referenciados
       se citan por sus constantes (guard test D-0019) y se miden en sus propias suites. -->
  <PropertyGroup>
    <CollectCoverage>true</CollectCoverage>
    <Threshold Condition="$(AWS_EMULATOR_ACCESS_KEY_ID) != ''">70</Threshold>
    <Threshold Condition="$(AWS_EMULATOR_ACCESS_KEY_ID) == ''">0</Threshold>
    <ThresholdType>line</ThresholdType>
    <ThresholdStat>total</ThresholdStat>
    <Exclude>[TicketFlow.Shared.Infrastructure]*,[TicketFlow.Catalog.Core]*,[TicketFlow.Orders.Core]*,[TicketFlow.Payments.Core]*,[TicketFlow.Ticketing.Core]*</Exclude>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.msbuild" Version="10.1.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.23" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TicketFlow.Provision\TicketFlow.Provision.csproj" />
    <ProjectReference Include="..\..\src\Services\Catalog\TicketFlow.Catalog.Core\TicketFlow.Catalog.Core.csproj" />
    <ProjectReference Include="..\..\src\Services\Orders\TicketFlow.Orders.Core\TicketFlow.Orders.Core.csproj" />
    <ProjectReference Include="..\..\src\Services\Payments\TicketFlow.Payments.Core\TicketFlow.Payments.Core.csproj" />
    <ProjectReference Include="..\..\src\Services\Ticketing\TicketFlow.Ticketing.Core\TicketFlow.Ticketing.Core.csproj" />
  </ItemGroup>

</Project>
